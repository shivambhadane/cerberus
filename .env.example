# Database. Defaults to a local SQLite file when unset.
DATABASE_URL=postgresql+psycopg2://cerberus:cerberus@localhost:5432/cerberus

# Enrichment data sources.
# NVD works without a key at 5 requests/30s; a key raises this to 50/30s and makes
# scans substantially faster. CISA KEV and EPSS are public and need no key.
NVD_API_KEY=

# API
API_HOST=0.0.0.0
API_PORT=8000
# Signs the access tokens that sign-in issues. REQUIRED: the API refuses to start with this unset,
# set to the placeholder "change-me", or shorter than 32 characters. Anyone who knows it can mint a
# token for any account. Generate one with:  openssl rand -hex 24
# Changing it signs everyone out (existing tokens stop verifying), which is also how you revoke them.
API_SECRET_KEY=

# Sessions. Access tokens are short because they cannot be revoked; the refresh token (which can be)
# mints the next one.
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=14
# Send the refresh cookie over HTTPS only. Leave 0 for http://localhost; set to 1 in any real
# deployment.
COOKIE_SECURE=0

# Sign-in. The dashboard signs people in with Firebase (Google, GitHub, email); the API verifies their ID
# tokens against Google's published keys for this Firebase project. Defaults to the project this repository
# was built against: set it to your own if you use your own Firebase project.
# FIREBASE_PROJECT_ID=

# Origins allowed to call the API from a browser (the dashboard dev server).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Deployment providers: prove ownership of a Vercel / Netlify / Cloudflare Pages app ---------------
# Optional. Without these, "Add a deployment" shows each provider as "Not set up on this server" and DNS
# TXT verification works exactly as before. The full setup for each provider is in docs/DEPLOYMENT.md.
#
# Encrypts the provider tokens stored in the database (Fernet). REQUIRED for any provider connection.
# Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ./run.sh generates one when this is empty. Keep it out of the repository and back it up: losing it
# makes every stored token unreadable (users just reconnect). To rotate, put the new key first and keep
# the old one after a comma; the first key encrypts, all of them decrypt.
PROVIDER_TOKEN_ENCRYPTION_KEY=
# Where this API is reached from the internet, and where the dashboard is. The OAuth redirect URI is
# PUBLIC_API_URL + /api/v1/providers/<provider>/callback and must match, character for character, what
# you register with each provider. Use https:// (and COOKIE_SECURE=1) anywhere but localhost.
PUBLIC_API_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173
# Vercel: an Integration (Vercel dashboard > Settings > Integrations > Create). SLUG is the last part of
# its install URL, https://vercel.com/integrations/<slug>.
VERCEL_CLIENT_ID=
VERCEL_CLIENT_SECRET=
VERCEL_INTEGRATION_SLUG=
# Netlify: an OAuth application (User settings > Applications > OAuth).
NETLIFY_CLIENT_ID=
NETLIFY_CLIENT_SECRET=
# Cloudflare: an OAuth client (authorization code + PKCE). Cloudflare does not publish the Pages read scope
# names, so list the scopes the client was created with, space-separated, exactly as Cloudflare shows them.
CLOUDFLARE_CLIENT_ID=
CLOUDFLARE_CLIENT_SECRET=
CLOUDFLARE_OAUTH_SCOPES=

# Tests only. Lets the backend accept "test-firebase-token:<email>:<uid>" as a sign-in token so the test
# suite does not need a real Firebase project. Never set this anywhere real: it lets anyone who can reach
# the API sign in as any email address. It is honoured only when set to exactly "1"; the test suite sets it.
# CERBERUS_ALLOW_TEST_TOKENS=

# Integrations (Phase 3 - not yet wired up)
SLACK_WEBHOOK_URL=
JIRA_BASE_URL=
JIRA_API_TOKEN=
JIRA_EMAIL=
