# Database. Defaults to a local SQLite file when unset.
DATABASE_URL=postgresql+psycopg2://cerberus:cerberus@localhost:5432/cerberus

# Enrichment data sources.
# NVD works without a key at 5 requests/30s; a key raises this to 50/30s and makes
# scans substantially faster. CISA KEV and EPSS are public and need no key.
NVD_API_KEY=

# API
API_HOST=0.0.0.0
API_PORT=8000
API_SECRET_KEY=change-me

# Integrations (Phase 3 - not yet wired up)
SLACK_WEBHOOK_URL=
JIRA_BASE_URL=
JIRA_API_TOKEN=
JIRA_EMAIL=
